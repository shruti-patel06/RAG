    "import ollama\n",
    "\n",
    "def ask_llm(prompt):\n",
    "\n",
    "    response = ollama.chat(\n",
    "        model=\"gemma3:1b\",\n",
    "        messages=[\n",
    "            {\n",
    "                \"role\": \"user\",\n",
    "                \"content\": prompt\n",
    "            }\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    return response[\"message\"][\"content\"]"
   ]
  },
